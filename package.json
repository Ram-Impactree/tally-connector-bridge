{
  "name": "tally-connector",
  "version": "1.0.0",
  "description": "Windows desktop connector for Tally local integration and cloud sync",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win",
    "dist:all": "node scripts/build-all.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist:win64": "electron-builder --win --x64",
    "dist:win32": "electron-builder --win --ia32",
    "dist:linux64": "electron-builder --linux --x64",
    "dist:linux32": "electron-builder --linux --ia32",
    "dist:linux-all": "node scripts/build-linux-all.js",
    "dist:mac": "electron-builder --mac --x64",
    "dist:macArm": "electron-builder --mac --arm64",
    "dist:mac-all": "node scripts/build-mac-all.js"
  },
  "keywords": [
    "tally",
    "electron",
    "connector"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.7.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.internproject.tallyconnector",
    "productName": "Tally Connector",
    "artifactName": "Tally Connector-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
       "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "build/icon.ico"
    },
     "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "ia32"]
        }
      ]
    },

    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
